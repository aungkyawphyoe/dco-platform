# Base URL of the Fastify API, including the /v1 prefix.
# Local dev: backend on http://localhost:8080 (see backend/docker-compose.yml).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1

# Store listing URLs — placeholders until the apps are published.
# Leave empty to render badge placeholders without links.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.dco.dco_mobile

# Contact address for the fleet "Contact sales" CTA.
NEXT_PUBLIC_FLEET_CONTACT_EMAIL=support@autoxmm.com

# Destination for demo requests when no form endpoint is configured. The form
# falls back to a pre-filled mailto: link to this address.
NEXT_PUBLIC_DEMO_REQUEST_EMAIL=support@autoxmm.com

# Optional JSON endpoint for the demo form (Formspree, Basin, your own API).
# When set, the form POSTs the request there instead of opening a mail app.
NEXT_PUBLIC_DEMO_REQUEST_ENDPOINT=

# Support address used on the Terms of Service and Privacy Policy pages.
NEXT_PUBLIC_SUPPORT_EMAIL=support@autoxmm.com
