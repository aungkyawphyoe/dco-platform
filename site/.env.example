# Base URL of the Fastify API, including the /v1 prefix.
# Local dev: backend on http://localhost:8080 (see backend/docker-compose.yml).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/v1

# Store listing URLs — placeholders until the apps are published.
# Leave empty to render badge placeholders without links.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Contact address for the fleet "Contact sales" CTA.
NEXT_PUBLIC_FLEET_CONTACT_EMAIL=
