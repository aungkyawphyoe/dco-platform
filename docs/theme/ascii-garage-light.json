  "typography": {
    "display": {
      "family": "IBM Plex Sans",
      "weight": 600,
      "size": 28,
      "lineHeight": 34,
      "letterSpacing": -0.3
    },
    "title": {
      "family": "IBM Plex Sans",
      "weight": 600,
      "size": 20,
      "lineHeight": 26
    },
    "body": {
      "family": "IBM Plex Sans",
      "weight": 400,
      "size": 16,
      "lineHeight": 26
    },
    "label": {
      "family": "IBM Plex Sans",
      "weight": 500,
      "size": 14,
      "lineHeight": 20,
      "letterSpacing": 0.2
    },
    "caption": {
      "family": "IBM Plex Sans",
      "weight": 400,
      "size": 12,
      "lineHeight": 16
    },
    "mono": {
      "family": "IBM Plex Mono",
      "weight": 400,
      "size": 13,
      "lineHeight": 18
    }
  },
  "elevation": {
    "none": "none",
    "card": "none",
    "modal": "0 12px 32px #0000001F"
  },
  "motion": {
    "fast": 120,
    "base": 180,
    "slow": 280,
    "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "respectReducedMotion": true
  },
  "usageNotes": {
    "activation": "Flutter tokens are generated from this pair. The marketing site uses marketing-tokens.css.",
    "text.accent": "Exact amber for dark surfaces; deep amber for readable small text and links on light surfaces. Use black labels on amber fills.",
    "border.default": "Functional input/control boundaries; subtle/divider values are decorative separators.",
    "status.warning vs text.accent": "Use distinct colors for semantic states and chart categories.",
    "marketing": "Marketing-only footer, grid, hero and reveal values. Do not apply 700ms reveals or the hero renderer to everyday product workflows.",
    "radius": "The site uses square corners. Flutter uses mobile.radius.",
    "migration": "The generator uses this pair for Flutter. Portal CSS uses its own JSON pair.",
    "typography": "Plex Sans headings/body, Plex Mono artwork. Preserve Myanmar-capable fallback and locale-specific leading."
  },
  "marketing": {
    "footer": {
      "background": "#FFA31A",
      "text": "#000000",
      "border": "#965100",
      "focus": "#000000"
    },
    "grid": {
      "maxWidth": 1280,
      "columns": 12,
      "desktopGutter": 48,
      "mobileGutter": 20,
      "ruleWidth": 1
    },
    "hero": {
      "desktopAspectRatio": 1.641025641025641,
      "cellPitch": 5,
      "mobileCellPitch": 4,
      "cellGap": 1,
      "targetFps": 20,
      "horizonRatio": 0.74,
      "carWidthRatio": 0.115,
      "cityMaxHeightRatio": 0.23,
      "mobileAspectRatio": 1.1470588235294117
    },
    "reveal": {
      "distance": 14,
      "duration": 700,
      "stagger": 60,
      "easing": "cubic-bezier(0.16, 1, 0.3, 1)"
    },
    "typography": {
      "heroSize": 94,
      "sectionSize": 56,
      "mobileHeroSize": 44
    },
    "control": {
      "filledBackground": "#000000",
      "filledText": "#FFFFFF",
      "inverseBackground": "#F7F7F5",
      "inverseText": "#000000"
    }
  }
}
