    "inactive": "#858580",
    "onAccent": "#000000",
    "inverse": "#000000"
  },
  "border": {
    "subtle": "#E1E1DB",
    "default": "#858580",
    "divider": "#D6D6CF",
    "highlight": "#965100",
    "focus": "#965100"
