{
  "themeName": "ASCII Garage Light",
  "version": "1.0",
  "mode": "light",
  "platforms": [
    "site",
    "mobile",
    "web",
    "fleet-portal"
  ],
  "description": "Mobile color tokens and marketing palette reference.",
  "background": {
    "primary": "#F7F7F5",
    "secondary": "#EEEEEA",
