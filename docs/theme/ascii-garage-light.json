  "radius": {
    "sm": 0,
    "md": 0,
    "lg": 0,
    "xl": 0,
    "full": 999
  },
  "mobile": {
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 12,
      "xl": 16,
      "full": 999
    }
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48
