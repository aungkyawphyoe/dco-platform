  "input": {
    "background": "#EEEEEA",
    "border": "#858580",
    "borderFocus": "#965100",
    "placeholder": "#6B6B64",
    "errorBorder": "#C04531"
  },
  "chart": {
    "fuel": "#C0761A",
    "maintenance": "#3E7CA6",
    "insurance": "#5B6FC4",
    "parking": "#5C7181",
    "tolls": "#6E7F91",
    "parts": "#3F8A68",
    "other": "#64737D"
