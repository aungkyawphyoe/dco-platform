  "typography": {
    "display": {
      "family": "IBM Plex Sans",
      "weight": 600,
      "size": 28,
      "lineHeight": 34,
      "letterSpacing": -0.3
    },
    "title": {
      "family": "IBM Plex Sans",
      "weight": 600,
      "size": 20,
      "lineHeight": 26
    },
    "body": {
      "family": "IBM Plex Sans",
      "weight": 400,
      "size": 16,
      "lineHeight": 26
