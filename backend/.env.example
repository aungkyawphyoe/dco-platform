APP_ENV=local
PORT=8080
DATABASE_URL=postgres://dco:dco@localhost:5432/dco
JWT_ACCESS_SECRET=dev-access-secret-change-me-please-32chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-please-32
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
JWT_OWNER_AUD=dco-owner
JWT_FLEET_AUD=dco-fleet
JWT_WORKSHOP_AUD=dco-workshop
JWT_ADMIN_AUD=dco-admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin1!
MAIL_PROVIDER=stdout
# off = accounts are auto-verified at signup (MVP); on = send verification email
EMAIL_VERIFICATION=off
MAIL_FROM=noreply@localhost
# Maintenance reminder email scan interval in minutes; 0 disables the in-process scheduler.
REMINDER_EMAIL_SCAN_MINUTES=15
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=var/media
MEDIA_SIGNING_KEY=dev-media-signing-key-change-me
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_API_URL=http://localhost:8080/v1

# New mobile onboarding/auth release. Enable only with a configured sender.
AUTH_CODES_ENABLED=off
# Generate an independent random 32+ character secret; never commit its value.
# AUTH_CODE_SECRET=
# Browser OAuth clients; use PUBLIC_API_URL/auth/social/{google|apple}/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY= (PKCS8 PEM; escaped newlines accepted)

# Set only after verifying the number of trusted, sanitizing ingress proxies.
AUTH_TRUST_PROXY_HOPS=0

# Google Play subscriptions (enable after supplying all credentials below).
PLAY_BILLING_ENABLED=off
PLAY_PACKAGE_NAME=com.dco.dco_mobile
# Entire downloaded service-account JSON, compacted onto ONE line, without outer quotes.
# Preserve escaped \n sequences inside JSON strings. This is not a file path.
# PLAY_SERVICE_ACCOUNT_JSON=
# For local RTDN, use a public HTTPS tunnel forwarding to this backend's port 8080.
# Set the Pub/Sub push endpoint AND audience to this exact tunnel URL plus route.
# PLAY_RTDN_AUDIENCE=https://YOUR_TUNNEL_HOST/v1/billing/google-play/notifications
# Push authentication identity (not the purchase-verification service account).
# PLAY_RTDN_SERVICE_ACCOUNT=autox-play-push@YOUR_PROJECT_ID.iam.gserviceaccount.com

# AutoX license signing; private key stays on the backend only.
# Reuse the private key matching the public key in mobile/assets/license_keys.json.
# If no key pair exists, run npm run license:key and add its public entry to that file.
# LICENSE_KID=copy-the-generated-key-id
# LICENSE_ED25519_KEY=
